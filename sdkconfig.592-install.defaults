CONFIG_ZION_592_INSTALL=y
CONFIG_ZION_FACTORY_SIZE=2097152
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.592.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.592.csv"
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_LV_USE_THEME_DEFAULT=n
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_FONT_DEFAULT_UNSCII_8=y
CONFIG_LV_FONT_MONTSERRAT_14=n
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
# Official HTTPS downloads use modern ECDHE groups. Keep P-256/P-384/X25519;
# remove unrelated curve implementations without disabling chain verification.
CONFIG_MBEDTLS_ECP_DP_SECP192R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP192K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n

# Allocate TLS records on demand instead of reserving a contiguous 16 KiB RX buffer.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

CONFIG_ZION_LAUNCHER=n
